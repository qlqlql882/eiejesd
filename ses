            autoBandageThread = task.spawn(function()
                while AutoBandage do
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health <= BandageHealth then
                        for _, v in ipairs(LocalPlayer.Backpack:GetChildren()) do
                            if v.Name == "Bandage" then
                                pcall(function()
                                    v.Parent = char
                                    local b = char:FindFirstChild("Bandage")
                                    if b and b:FindFirstChild("Use") then b.Use:FireServer() end
                                end)
                                break
                            end
                        end
                    end
                    task.wait(0.5)
                end
            end)
        else
            if autoBandageThread then task.cancel(autoBandageThread); autoBandageThread = nil end
        end
    end,
})

