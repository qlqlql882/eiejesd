-- 通用 ESP
local function makeESP(box, toggleName, label, folderName, itemName, color)
    local conn
    box:AddToggle(toggleName, {
        Text = label, Default = false,
        Callback = function(value)
            if value then
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    for _, v in ipairs(folder:GetChildren()) do
                        if (not itemName or v.Name == itemName) and v:IsA("Model") then
                            createBillboard(v, itemName or v.Name, color)
                        end
                    end
                    conn = folder.ChildAdded:Connect(function(v)
                        if (not itemName or v.Name == itemName) and v:IsA("Model") then
                            task.wait(0.2)
                            createBillboard(v, itemName or v.Name, color)
                        end
                    end)
                end
            else
                if conn then conn:Disconnect(); conn = nil end
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    for _, v in ipairs(folder:GetChildren()) do
                        local bill = v:FindFirstChild("BillboardGui")
                        if bill then bill:Destroy() end
                    end
                end
            end
        end,
    })
end

