-- ==================== Obsidian UI ====================
local repo = "https://cdn.jsdelivr.net/gh/ATLASTEAM01/Obsidian@main/"
local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()

local Window = Library:CreateWindow({
    Title = "Prayforsnow X",
    Footer = "扫描工具",
    Center = true,
    AutoShow = true,
})

local Tab = Window:AddTab("扫描", "search")

-- ==================== 扫描结果（Dropdown） ====================
local ScanGroup = Tab:AddLeftGroupbox("扫描结果")

local ScanResult = {}

-- 结果显示为 Dropdown（点开滚动查看）
local ResultDropdown = ScanGroup:AddDropdown("scan_result", {
    Text = "扫描结果（点开查看）",
    Values = {"还没有扫描"},
    Default = "还没有扫描",
    Multi = false,
    Searchable = true,
})

local CountLabel = ScanGroup:AddLabel("共 0 项")

-- 刷新下拉
local function RefreshDropdown()
    if #ScanResult == 0 then
        ResultDropdown:SetValues({"还没有扫描"})
        CountLabel:SetText("共 0 项")
    else
        ResultDropdown:SetValues(ScanResult)
        CountLabel:SetText("共 " .. #ScanResult .. " 项")
    end
end

-- ==================== 操作 ====================
local ActionGroup = Tab:AddRightGroupbox("操作")

ActionGroup:AddButton({
    Text = "🔍 扫描全部物件",
    Func = function()
        ScanResult = {}
        local found = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "" then
                local isChar = false
                for _, p in ipairs(game.Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        isChar = true
                        break
                    end
                end
                if not isChar then
                    found[obj.Name] = (found[obj.Name] or 0) + 1
                end
            end
        end

        for name, num in pairs(found) do
            table.insert(ScanResult, name .. " ×" .. num)
        end
        table.sort(ScanResult)

        RefreshDropdown()
        Library:Notify("Prayforsnow X", "扫描完成，共 " .. #ScanResult .. " 项", 3)
    end,
})

ActionGroup:AddButton({
    Text = "💰 只看钱相关",
    Func = function()
        ScanResult = {}
        local keywords = {"coin", "cash", "money", "dollar", "gold", "bill", "gem", "credit", "bar", "note", "crate"}
        local found = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "" then
                local isChar = false
                for _, p in ipairs(game.Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then
                        isChar = true
                        break
                    end
                end
                if not isChar then
                    local lower = obj.Name:lower()
                    for _, kw in ipairs(keywords) do
                        if lower:find(kw) then
                            found[obj.Name] = (found[obj.Name] or 0) + 1
                            break
                        end
                    end
                end
            end
        end

        for name, num in pairs(found) do
            table.insert(ScanResult, name .. " ×" .. num)
        end
        table.sort(ScanResult)

        RefreshDropdown()

        if #ScanResult == 0 then
            Library:Notify("Prayforsnow X", "没找到钱相关物件", 3)
        else
            Library:Notify("Prayforsnow X", "找到 " .. #ScanResult .. " 项钱相关", 3)
        end
    end,
})

ActionGroup:AddButton({
    Text = "🗑️ 清空结果",
    Func = function()
        ScanResult = {}
        RefreshDropdown()
    end,
})

Library:Notify("Prayforsnow X", "扫描工具加载完成", 3)
