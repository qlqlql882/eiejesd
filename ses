-- ==========================================================
-- UI 汉化逻辑
-- ==========================================================
local TranslationEnabled = false
local playerGuiConn, coreGuiConn

-- 判断文字是否含英文
local function HasEnglish(text)
    if not text or text == "" then return false end
    local eng, total = 0, 0
    for c in text:gmatch(".") do
        local b = string.byte(c)
        if b then
            total = total + 1
            if (b >= 65 and b <= 90) or (b >= 97 and b <= 122) then
                eng = eng + 1
            end
        end
    end
    return total > 0 and (eng / total) > 0.3
end

-- 翻译单个控件
local function ProcessText(obj)
    if not TranslationEnabled then return end
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end
    local orig = obj.Text
    if not orig or orig == "" then return end
    if not HasEnglish(orig) then return end

    -- 整段匹配优先
    if UITranslate[orig] then
        obj.Text = UITranslate[orig]
        return
    end

    -- 部分匹配（整词替换）
    local newText = orig
    for eng, cn in pairs(UITranslate) do
        local pattern = "%f[%a]" .. eng:gsub("(%W)", "%%%1") .. "%f[%A]"
        newText = newText:gsub(pattern, cn)
    end
    if newText ~= orig then
        obj.Text = newText
    end
end

-- 扫描父级下所有文本控件
local function ScanUI(parent)
    if not TranslationEnabled then return end
    for _, d in ipairs(parent:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
            task.spawn(ProcessText, d)
        end
    end
end

-- 监听新出现的 UI
local function OnDescendantAdded(d)
    if not TranslationEnabled then return end
    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
        task.delay(0.1, ProcessText, d)
    end
end

-- 启动翻译
local function StartTranslation()
    if playerGuiConn then playerGuiConn:Disconnect() end
    if coreGuiConn then coreGuiConn:Disconnect() end
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    playerGuiConn = pg.DescendantAdded:Connect(OnDescendantAdded)
    coreGuiConn = CoreGui.DescendantAdded:Connect(OnDescendantAdded)
    ScanUI(pg)
    pcall(function()
        for _, g in ipairs(CoreGui:GetChildren()) do
            if g:IsA("ScreenGui") then ScanUI(g) end
        end
    end)
end

-- 停止翻译
local function StopTranslation()
    if playerGuiConn then playerGuiConn:Disconnect(); playerGuiConn = nil end
    if coreGuiConn then coreGuiConn:Disconnect(); coreGuiConn = nil end
end

