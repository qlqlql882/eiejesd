local AllItems, AllItemsList, NameToId = {}, {}, {}
local ItemDropdown  -- 必须前置声明，避免 UpdateDropdown 拿到 nil
local BringDelay = 0.05

-- ==========================================================
-- 拾取三连发（源码方式）
-- ==========================================================
local function StoreBySource(sr)
    pcall(function() Remotes.Store:FireServer(sr) end)
    pcall(function() Remotes.Store:FireServer() end)
    pcall(function() Event:FireServer(sr) end)
end

local function BringItemSource(targetId)
    local count = 0
    for id = 1, 200000 do
        local ok, has = pcall(function() return world:has(id, comps.Storable) end)
        if ok and has then
            local ok2, oid = pcall(function() return world:get(id, comps.ObjectId) end)
            if ok2 and oid == targetId then
                local ok3, sr = pcall(function() return replicator:get_server_entity(id) end)
                if ok3 and sr and sr ~= id then
                    StoreBySource(sr)
                    count = count + 1
                    task.wait(BringDelay)
                end
            end
        end
    end
    return count
end

local function BringAllSource()
    local count = 0
    for id = 1, 200000 do
        local ok, has = pcall(function() return world:has(id, comps.Storable) end)
        if ok and has then
            local ok2, oid = pcall(function() return world:get(id, comps.ObjectId) end)
            if ok2 and oid then
                local ok3, sr = pcall(function() return replicator:get_server_entity(id) end)
                if ok3 and sr and sr ~= id then
                    StoreBySource(sr)
                    count = count + 1
                    task.wait(BringDelay)
                end
            end
        end
    end
    return count
end

-- ==========================================================
-- 扫描
-- ==========================================================
local function ScanAll()
    if not world then return end
    AllItems = {}
    for id = 1, 200000 do
        local ok, has = pcall(function() return world:has(id, comps.Storable) end)
        if ok and has then
            local ok2, oid = pcall(function() return world:get(id, comps.ObjectId) end)
            if ok2 and oid then AllItems[oid] = (AllItems[oid] or 0) + 1 end
        end
    end
end

local function UpdateDropdown()
    AllItemsList, NameToId = {}, {}
    for oid, count in pairs(AllItems) do
        local display = GetDisplay(oid) .. " ×" .. count
        table.insert(AllItemsList, display)
        NameToId[display] = oid
    end
    table.sort(AllItemsList)
    ItemDropdown:SetValues(#AllItemsList == 0 and {"未找到"} or AllItemsList)
end

