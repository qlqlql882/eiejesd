-- 翻译：长词优先匹配，避免误翻
local function translate(name)
    local lower = name:lower()

    if TranslateMap[lower] then
        return TranslateMap[lower]
    end

    local keys = {}
    for k, _ in pairs(TranslateMap) do
        table.insert(keys, k)
    end
    table.sort(keys, function(a, b) return #a > #b end)

    for _, key in ipairs(keys) do
        if lower:find(key, 1, true) then
            return TranslateMap[key]
        end
    end

    return nil
end

-- ==================== 扫描结果 ====================
local ScanGroup = Tab:AddLeftGroupbox("扫描结果")

local ScanResult = {}
local ScanObjects = {}

local ResultDropdown = ScanGroup:AddDropdown("scan_drop", {
    Text = "扫描结果（点开滚动查看）",
    Values = {"还没有扫描"},
    Default = "还没有扫描",
    Multi = false,
    Searchable = true,
})

local CountLabel = ScanGroup:AddLabel("共 0 项")

local function RefreshDropdown()
    if #ScanResult == 0 then
        ResultDropdown:SetValues({"还没有扫描"})
        CountLabel:SetText("共 0 项")
    else
        ResultDropdown:SetValues(ScanResult)
        CountLabel:SetText("共 " .. #ScanResult .. " 项")
    end
end

-- ==================== 操作 ====================
local ActionGroup = Tab:AddRightGroupbox("操作")

local StatusLabel = ActionGroup:AddLabel("状态：就绪")

local function ScanAll(filterMoney)
    ScanResult = {}
    ScanObjects = {}
    local found = {}
    local keywords = {"coin", "cash", "money", "dollar", "gold", "bill", "gem", "credit", "bar", "note", "crate"}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "" then
            local isChar = false
            for _, p in ipairs(game.Players:GetPlayers()) do
                if p.Character and obj:IsDescendantOf(p.Character) then
                    isChar = true
                    break
                end
            end
            if not isChar then
                local shouldAdd = true
                if filterMoney then
                    shouldAdd = false
                    local lower = obj.Name:lower()
                    for _, kw in ipairs(keywords) do
                        if lower:find(kw) then
                            shouldAdd = true
                            break
                        end
                    end
                end
                if shouldAdd then
                    found[obj.Name] = (found[obj.Name] or 0) + 1
                end
            end
        end
    end

    for name, num in pairs(found) do
        local chn = translate(name)
        local display
        if chn then
            display = chn .. " (" .. name .. ") ×" .. num
        else
            display = name .. " ×" .. num
        end
        table.insert(ScanResult, display)
        ScanObjects[display] = name
    end
    table.sort(ScanResult)

    RefreshDropdown()
    RefreshCollectDropdown()
    StatusLabel:SetText("扫描完成，共 " .. #ScanResult .. " 项")
end

ActionGroup:AddButton({
    Text = "🔍 扫描全部物件",
    Func = function()
        ScanAll(false)
    end,
})

ActionGroup:AddButton({
    Text = "💰 只看钱相关",
