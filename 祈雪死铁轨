-- ==================== 动画逻辑 ====================
TweenService:Create(blur, TweenInfo.new(0.6), {Size = 24}):Play()

task.spawn(function()
    local stages = {
        {p = 20, t = "下载 UI 库..."},
        {p = 50, t = "初始化组件..."},
        {p = 80, t = "加载功能..."},
        {p = 100, t = "加载完成！"},
    }
    for _, s in ipairs(stages) do
        sub.Text = s.t
        TweenService:Create(barFill, TweenInfo.new(0.4), {Size = UDim2.new(s.p/100, 0, 1, 0)}):Play()
        task.wait(0.5)
        percent.Text = s.p .. "%"
    end

    task.wait(0.5)

    -- 淡出
    local fade = 0.6
    TweenService:Create(bg, TweenInfo.new(fade), {BackgroundTransparency = 1}):Play()
    TweenService:Create(logoBox, TweenInfo.new(fade), {BackgroundTransparency = 1}):Play()
    TweenService:Create(logoStroke, TweenInfo.new(fade), {Transparency = 1}):Play()
    TweenService:Create(logoText, TweenInfo.new(fade), {TextTransparency = 1}):Play()
    TweenService:Create(title, TweenInfo.new(fade), {TextTransparency = 1}):Play()
    TweenService:Create(sub, TweenInfo.new(fade), {TextTransparency = 1}):Play()
    TweenService:Create(barBg, TweenInfo.new(fade), {BackgroundTransparency = 1}):Play()
    TweenService:Create(barFill, TweenInfo.new(fade), {BackgroundTransparency = 1}):Play()
    TweenService:Create(percent, TweenInfo.new(fade), {TextTransparency = 1}):Play()
    TweenService:Create(blur, TweenInfo.new(fade), {Size = 0}):Play()

    task.wait(fade + 0.1)
    splash:Destroy()
    blur:Destroy()
end)

