T.collect = function(on)
    if on then
        T._c = RunService.Heartbeat:Connect(function()
            local hrp = HRP(); if not hrp then return end
            for _, o in ipairs(workspace:GetDescendants()) do
                if o:IsA("BasePart") and (
                    o.Name:lower():find("coin") or
                    o.Name:lower():find("item") or
                    o.Name:lower():find("drop")) then
                    pcall(function() o.CFrame = hrp.CFrame end)
