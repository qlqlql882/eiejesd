T.shockwave = function(on)
    if on then
        T._swActive = true
        T._sw = task.spawn(function()
            while T._swActive do
                local hrp = HRP()
                if hrp then
                    local ring = Instance.new("Part")
                    ring.Shape = Enum.PartType.Cylinder
                    ring.Size = Vector3.new(0.2, 1, 1)
                    ring.Color = Color3.fromRGB(0, 255, 255)
                    ring.Material = Enum.Material.Neon
                    ring.Anchored = true
                    ring.CanCollide = false
                    ring.CFrame = CFrame.new(hrp.Position - Vector3.new(0,3,0))
                    ring.Parent = workspace
                    task.spawn(function()
                        for i = 1, 20 do
                            if not ring or not ring.Parent then break end
                            ring.Size = Vector3.new(0.2, 1 + i*2, 1 + i*2)
                            ring.Transparency = i/20
                            task.wait(0.03)
                        end
                        if ring then ring:Destroy() end
                    end)
                end
                task.wait(2)
            end
        end)
    else
        T._swActive = false
        if T._sw then T._sw = nil end
    end
end

