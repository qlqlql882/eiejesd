-- ==================== 移动 ====================
T.fly = function(on)
    if on then
        local hrp = HRP()
        if not hrp then return end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FlyBV"
        bv.MaxForce = Vector3.new(1e5,1e5,1e5)
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = hrp
        T._flyBV = bv
        T._flyLoop = RunService.RenderStepped:Connect(function()
            if not T._flyBV then return end
            local cam = workspace.CurrentCamera
            local h = HUM()
            if not h then return end
            local move = Vector3.new()
            local md = h.MoveDirection
            if md.Magnitude > 0 then move = move + md end
            if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) or h.Jump then move = move + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0,1,0) end
            T._flyBV.Velocity = move * 80
        end)
    else
        if T._flyBV then T._flyBV:Destroy(); T._flyBV = nil end
        if T._flyLoop then T._flyLoop:Disconnect(); T._flyLoop = nil end
    end
end

T.superjump = function(on)
    local h = HUM()
    if h then
        h.UseJumpPower = true
        h.JumpPower = on and 300 or 50
    end
end

T.bunnyhop = function(on)
    if on then
        T._bh = RunService.Heartbeat:Connect(function()
            local h = HUM()
            if h and h:GetState() == Enum.HumanoidStateType.Landed then
                h:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    else
        if T._bh then T._bh:Disconnect(); T._bh = nil end
    end
end

