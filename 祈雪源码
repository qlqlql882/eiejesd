            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Name:lower():find("coin") or obj.Name:lower():find("item") or obj.Name:lower():find("drop") or obj.Name:lower():find("gem")) then
