-- ==================== 功能实现 ====================
T.god = function(on)
    local c = Players.LocalPlayer.Character
    if not c then return end
    if on then
        local f = Instance.new("ForceField"); f.Name = "GodFF"; f.Parent = c
    else
        local f = c:FindFirstChild("GodFF"); if f then f:Destroy() end
    end
end

T.superspeed = function(on)
    local h = HUM(); if h then h.WalkSpeed = on and 1000 or 16 end
end

T.infstamina = function(on)
    if on then
        T._s = RunService.Heartbeat:Connect(function()
            local h = HUM(); if h then h.Health = h.MaxHealth end
        end)
    else
        if T._s then T._s:Disconnect(); T._s = nil end
    end
end

T.serverinfo = function(on)
    if not on then return end
    local s = {"人数: " .. #Players:GetPlayers()}
    for _, p in ipairs(Players:GetPlayers()) do
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            table.insert(s, p.Name .. " | " ..
                math.floor(hrp.Position.X) .. "," ..
                math.floor(hrp.Position.Y) .. "," ..
                math.floor(hrp.Position.Z))
        end
    end
    Ntf("服务器信息", table.concat(s, "\n"), 5)
end

T.collect = function(on)
    if on then
        T._c = RunService.Heartbeat:Connect(function()
            local hrp = HRP(); if not hrp then return end
            for _, o in ipairs(workspace:GetDescendants()) do
                if o:IsA("BasePart") and (
                    o.Name:lower():find("coin") or
                    o.Name:lower():find("item") or
                    o.Name:lower():find("drop")) then
                    pcall(function() o.CFrame = hrp.CFrame end)
                end
            end
        end)
    else
        if T._c then T._c:Disconnect(); T._c = nil end
    end
end

T.clicktp = function(on)
    if on then
        T._ct = UIS.InputBegan:Connect(function(i, g)
            if g or i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            local cam = workspace.CurrentCamera
            local mp = UIS:GetMouseLocation()
            local ray = cam:ViewportPointToRay(mp.X, mp.Y)
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {Players.LocalPlayer.Character}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local r = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
            if r then
                local hrp = HRP()
                if hrp then hrp.CFrame = CFrame.new(r.Position + Vector3.new(0, 3, 0)) end
            end
        end)
    else
        if T._ct then T._ct:Disconnect(); T._ct = nil end
    end
end

T.autoclick = function(on)
    if on then
        T._a = RunService.RenderStepped:Connect(function()
            pcall(function()
                VU:ClickButton1(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            end)
        end)
    else
        if T._a then T._a:Disconnect(); T._a = nil end
    end
end

T.float = function(on)
    if on then
        T._f = RunService.Heartbeat:Connect(function()
            local hrp = HRP()
            if not hrp then return end
            local v = hrp.Velocity
            hrp.Velocity = Vector3.new(v.X, 0, v.Z)
        end)
    else
        if T._f then T._f:Disconnect(); T._f = nil end
    end
end

T.speedhack = function(on)
    local h = HUM()
    if on then
        if h then h.WalkSpeed = 100 end
        workspace.Gravity = 100
    else
        if h then h.WalkSpeed = 16 end
        workspace.Gravity = 196
    end
end

T.noclip = function(on)
    if on then
        T._n = RunService.Stepped:Connect(function()
            local c = Players.LocalPlayer.Character; if not c then return end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    else
        if T._n then T._n:Disconnect(); T._n = nil end
    end
end

T.itemesp = function(on)
    if on then
        T._ie = {}
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("BasePart") and (
                o.Name:lower():find("coin") or
                o.Name:lower():find("item") or
                o.Name:lower():find("drop")) then
                pcall(function()
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(255, 255, 0)
                    h.OutlineColor = Color3.fromRGB(255, 255, 0)
                    h.FillTransparency = 0.5
                    h.Parent = o
                    table.insert(T._ie, h)
                end)
            end
        end
    else
        if T._ie then
            for _, h in ipairs(T._ie) do pcall(function() h:Destroy() end) end
            T._ie = nil
        end
    end
end

T.invisible = function(on)
    local c = Players.LocalPlayer.Character; if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") or p:IsA("Decal") then
            pcall(function() p.Transparency = on and 1 or 0 end)
        end
    end
end

T.deletepart = function(on)
    if on then
        T._d = UIS.InputBegan:Connect(function(i, g)
            if g or i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            local cam = workspace.CurrentCamera
            local mp = UIS:GetMouseLocation()
            local ray = cam:ViewportPointToRay(mp.X, mp.Y)
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {Players.LocalPlayer.Character}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local r = workspace:Raycast(ray.Origin, ray.Direction * 1000, rp)
            if r and r.Instance then pcall(function() r.Instance:Destroy() end) end
        end)
    else
        if T._d then T._d:Disconnect(); T._d = nil end
    end
end

T.clearfog = function(on)
    if on then LT.FogEnd = 1e5; LT.FogStart = 1e5
    else LT.FogEnd = 1000; LT.FogStart = 0 end
end

T.infjump = function(on)
    if on then
        T._j = UIS.JumpRequest:Connect(function()
            local h = HUM(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    else
        if T._j then T._j:Disconnect(); T._j = nil end
    end
end

T.night = function(on)
    if on then
        LT.Ambient = Color3.fromRGB(180, 180, 180); LT.Brightness = 3
    else
        LT.Ambient = Color3.fromRGB(70, 70, 70); LT.Brightness = 1
    end
end

T.fps = function(on)
    if on then
        local g = Instance.new("ScreenGui")
        g.Name = "FPSGui"
        g.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
        local l = Instance.new("TextLabel")
        l.Parent = g
        l.Position = UDim2.new(0, 10, 0, 10)
        l.Size = UDim2.new(0, 150, 0, 40)
        l.BackgroundTransparency = 0.5
        l.BackgroundColor3 = Color3.new(0, 0, 0)
        l.TextColor3 = Color3.new(0, 1, 0)
        l.TextScaled = true
        l.Text = "FPS: 0"
        local fr, last = 0, tick()
        T._fp = RunService.RenderStepped:Connect(function()
            fr = fr + 1
            if tick() - last >= 1 then
                l.Text = "FPS: " .. fr
                fr = 0; last = tick()
            end
        end)
        T._fg = g
    else
        if T._fp then T._fp:Disconnect(); T._fp = nil end
        if T._fg then T._fg:Destroy(); T._fg = nil end
    end
end

T.esp = function(on)
    if on then
        T._e = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Players.LocalPlayer and p.Character then
                pcall(function()
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(255, 0, 0)
                    h.OutlineColor = Color3.fromRGB(255, 0, 0)
                    h.FillTransparency = 0.5
                    h.Parent = p.Character
                    table.insert(T._e, h)
                end)
            end
        end
    else
        if T._e then
            for _, h in ipairs(T._e) do pcall(function() h:Destroy() end) end
            T._e = nil
        end
    end
end

T.teamglow = function(on)
    if on then
        T._tg = {}
        local mt = Players.LocalPlayer.Team
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Players.LocalPlayer and p.Team == mt and p.Character then
                pcall(function()
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(0, 100, 255)
                    h.OutlineColor = Color3.fromRGB(0, 100, 255)
                    h.FillTransparency = 0.5
                    h.Parent = p.Character
                    table.insert(T._tg, h)
                end)
            end
        end
    else
        if T._tg then
            for _, h in ipairs(T._tg) do pcall(function() h:Destroy() end) end
            T._tg = nil
        end
    end
end

T.enemyglow = function(on)
    if on then
        T._eg = {}
        local mt = Players.LocalPlayer.Team
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= Players.LocalPlayer and p.Team ~= mt and p.Character then
                pcall(function()
                    local h = Instance.new("Highlight")
                    h.FillColor = Color3.fromRGB(255, 0, 0)
                    h.OutlineColor = Color3.fromRGB(255, 0, 0)
                    h.FillTransparency = 0.5
                    h.Parent = p.Character
                    table.insert(T._eg, h)
                end)
            end
        end
    else
        if T._eg then
            for _, h in ipairs(T._eg) do pcall(function() h:Destroy() end) end
            T._eg = nil
        end
    end
end

T.fulllight = function(on)
