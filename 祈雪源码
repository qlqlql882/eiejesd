        label.BackgroundTransparency = 0.5
        label.BackgroundColor3 = Color3.new(0, 0, 0)
        label.TextColor3 = Color3.new(0, 1, 0)
        label.TextScaled = true
        label.Text = "FPS: 0"
        local frames = 0
        local lastTime = tick()
        Connections.fps = RunService.RenderStepped:Connect(function()
            frames = frames + 1
            if tick() - lastTime >= 1 then
                label.Text = "FPS: " .. frames
                frames = 0
                lastTime = tick()
            end
        end)
        Connections.fpsGui = ScreenGui
    else
        if Connections.fps then Connections.fps:Disconnect(); Connections.fps = nil end
        if Connections.fpsGui then Connections.fpsGui:Destroy(); Connections.fpsGui = nil end
    end
end

