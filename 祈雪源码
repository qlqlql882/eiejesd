T.antikick = function(on)
    if on then
        T._kick = true
        pcall(function()
            local mt = getrawmetatable(game)
            if mt then
                local old = mt.__namecall
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local m = getnamecallmethod()
                    if T._kick and (m == "Kick" or m == "kick") then return end
                    return old(self, ...)
                end)
                setreadonly(mt, true)
            end
        end)
    else
        T._kick = false
    end
end

