T.clones = function(on)
    if on then
        T._clones = {}
        T._cloneLoop = RunService.Heartbeat:Connect(function()
            local c = Players.LocalPlayer.Character
            if not c then return end
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            for i = 1, 4 do
                if not T._clones[i] or not T._clones[i].Parent then
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(2, 5, 1)
                    p.Color = Color3.fromRGB(255, 255, 255)
                    p.Material = Enum.Material.ForceField
                    p.Anchored = true
                    p.CanCollide = false
                    p.Transparency = 0.3
                    p.Parent = workspace
                    T._clones[i] = p
                end
                local angle = math.rad(i * 90 + tick() * 100)
                T._clones[i].CFrame = hrp.CFrame * CFrame.new(math.cos(angle)*5, 0, math.sin(angle)*5)
            end
        end)
    else
        if T._cloneLoop then T._cloneLoop:Disconnect(); T._cloneLoop = nil end
        if T._clones then
            for _, p in ipairs(T._clones) do pcall(function() p:Destroy() end) end
            T._clones = nil
        end
    end
end

