-- ==================== WindUI 加载（带重试） ====================
local WindUI
for i = 1, 5 do
    local ok, res = pcall(function()
        return loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/download/1.5.0/main.lua"))()
    end)
    if ok and res then
        WindUI = res
        break
    end
    task.wait(1)
end

if not WindUI then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "加载失败",
        Text = "WindUI 下载失败，请重试",
        Duration = 10,
    })
    return
end

