-- ==================== 拖动窗口 ====================
local dragging,dragStart,startPos
titleBar.InputBegan:Connect(function(input)
if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
dragging=true
dragStart=input.Position
startPos=win.Position
end
end)
titleBar.InputEnded:Connect(function(input)
if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
dragging=false
end
end)
UIS.InputChanged:Connect(function(input)
if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
local delta=input.Position-dragStart
win.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
end
end)
-- ==================== 快捷键 ====================
UIS.InputBegan:Connect(function(input,gpe)
if gpe then return end
if input.KeyCode==Enum.KeyCode.RightAlt then
State.aimbotOn=not State.aimbotOn
if State.aimbotOn then startAimbot(); updateFovCircle() else
if aimbotLoop then aimbotLoop:Disconnect(); aimbotLoop=nil end
if fovCircleGui then fovCircleGui:Destroy(); fovCircleGui=nil end
end
elseif input.KeyCode==Enum.KeyCode.LeftAlt then
State.espOn=not State.espOn
applyEsp()
elseif input.KeyCode==Enum.KeyCode.CapsLock then
State.espEnhancedOn=not State.espEnhancedOn
if not State.espEnhancedOn then clearEspEnhanced() end
elseif input.KeyCode==Enum.KeyCode.P then
crossGui.Enabled=not crossGui.Enabled
elseif input.KeyCode==Enum.KeyCode.F then
fpsGui.Enabled=not fpsGui.Enabled
elseif input.KeyCode==Enum.KeyCode.G then
State.flyOn=not State.flyOn
if State.flyOn then startFly() else stopFly() end
end
end)
