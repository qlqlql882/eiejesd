local function startAimbot()
if aimbotLoop then aimbotLoop:Disconnect() end
aimbotLoop=RunService.RenderStepped:Connect(function()
if not State.aimbotOn then return end
if State.aimbotForceLock then
if State.aimbotLockedTarget then
local t=State.aimbotLockedTarget
if not t.Parent then
State.aimbotLockedTarget=nil
else
local hum=t.Parent:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health<=0 then
State.aimbotLockedTarget=nil
end
end
end
if not State.aimbotLockedTarget then
State.aimbotLockedTarget=getAimbotTarget()
end
if State.aimbotLockedTarget then
local cam=workspace.CurrentCamera
local lookAt=CFrame.new(cam.CFrame.Position,State.aimbotLockedTarget.Position)
cam.CFrame=cam.CFrame:Lerp(lookAt,State.aimbotSmooth)
end
else
local target=getAimbotTarget()
if target then
local cam=workspace.CurrentCamera
local lookAt=CFrame.new(cam.CFrame.Position,target.Position)
cam.CFrame=cam.CFrame:Lerp(lookAt,State.aimbotSmooth)
end
State.aimbotLockedTarget=nil
end
end)
end
