local function savePreset(name)
local preset={
aimbotOn=State.aimbotOn,
aimbotForceLock=State.aimbotForceLock,
aimbotPart=State.aimbotPart,
aimbotTeam=State.aimbotTeam,
aimbotFov=State.aimbotFov,
aimbotSmooth=State.aimbotSmooth,
espOn=State.espOn,
espTeam=State.espTeam,
espEnhancedOn=State.espEnhancedOn,
flySpeed=State.flySpeed,
}
pcall(function()
if writefile then
writefile("PrayPreset_"..name..".json",HttpService:JSONEncode(preset))
end
end)
end
local function loadPreset(name)
pcall(function()
if isfile and isfile("PrayPreset_"..name..".json") then
local data=HttpService:JSONDecode(readfile("PrayPreset_"..name..".json"))
for k,v in pairs(data) do State[k]=v end
end
end)
end
