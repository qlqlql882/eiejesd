local espHighlights = {}
local function clearEsp()
    for _, h in ipairs(espHighlights) do
        pcall(function() h:Destroy() end)
    end
    espHighlights = {}
end

local function applyEsp()
    clearEsp()
    if not State.espOn then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            -- 阵营过滤
            local shouldShow = true
            if State.espTeam == "队伍" and not isTeammate(p) then shouldShow = false end
            if State.espTeam == "敌人" and isTeammate(p) then shouldShow = false end

            if shouldShow then
                local color = isTeammate(p) and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(255, 0, 0)
                pcall(function()
                    local h = Instance.new("Highlight")
                    h.FillColor = color
                    h.OutlineColor = color
                    h.FillTransparency = 0.5
                    h.Parent = p.Character
                    table.insert(espHighlights, h)
                end)
            end
        end
    end
end

-- 飞行（相机方向）
local flyBV, flyLoop
local function startFly()
    if flyLoop then flyLoop:Disconnect() end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.new(0, 0, 0)
    flyBV.Parent = hrp

    flyLoop = RunService.RenderStepped:Connect(function()
        if not State.flyOn or not flyBV then return end
        local cam = workspace.CurrentCamera
        local c = LP.Character
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local move = hum.MoveDirection
        flyBV.Velocity = move * State.flySpeed
    end)
end

local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyLoop then flyLoop:Disconnect(); flyLoop = nil end
end

-- 绕过反作弊
local function enableBypass()
    if not hookmetamethod or not newcclosure then return end
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if State.bypassOn then
                -- 拦截 Kick
                if method == "Kick" and self == LP then
                    return
                end
                -- 拦截反作弊上报
                if method == "FireServer" and self.Name == "PlayerEvent" then
                    local args = {...}
                    if args[1] == "combatMode" or args[1] == "takeDamage" then
                        return
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

