-- 判断是否是队友
local function isTeammate(player)
    if not player.Team then return false end
    return player.Team == LP.Team
end

-- 判断该玩家是否为目标
local function isValidTarget(player)
    if player == LP then return false end
    if not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local mode = State.aimbotTeam
    if mode == "队伍" and not isTeammate(player) then return false end
    if mode == "敌人" and isTeammate(player) then return false end
    return true
end

-- 自瞄
local function getAimbotTarget()
    local cam = workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    local best, bestDist = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if isValidTarget(p) then
            local targetPart
            if State.aimbotPart == "头部" then
                targetPart = p.Character:FindFirstChild("Head")
            else
                targetPart = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")
            end
            if not targetPart then
                targetPart = p.Character:FindFirstChild("HumanoidRootPart")
            end

            if targetPart then
                local screenPos, onScreen = cam:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local dx = screenPos.X - center.X
                    local dy = screenPos.Y - center.Y
                    local dist = math.sqrt(dx*dx + dy*dy)
                    if dist <= State.aimbotFov and dist < bestDist then
                        best = targetPart
                        bestDist = dist
                    end
                end
            end
        end
    end
    return best
end

local aimbotLoop
local function startAimbot()
    if aimbotLoop then aimbotLoop:Disconnect() end
    aimbotLoop = RunService.RenderStepped:Connect(function()
        if not State.aimbotOn then return end
        local target = getAimbotTarget()
        if target then
            local cam = workspace.CurrentCamera
            local lookAt = CFrame.new(cam.CFrame.Position, target.Position)
            cam.CFrame = cam.CFrame:Lerp(lookAt, State.aimbotSmooth)
        end
    end)
end

