local function createMeteor()
    local m = Instance.new("Frame")
    local startY = math.random(0, 100) / 100
    m.Size = UDim2.new(0, math.random(80, 200), 0, 2)
    m.Position = UDim2.new(-0.3, 0, startY, 0)
    m.BackgroundColor3 = Color3.fromRGB(180, 220, 255)
    m.BorderSizePixel = 0
    m.Rotation = math.random(-5, 5)
    m.Parent = bg

    local grad = Instance.new("UIGradient")
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.2),
        NumberSequenceKeypoint.new(1, 0),
    })
    grad.Parent = m

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = m

    local duration = math.random(15, 30) / 10
    local tween = TweenService:Create(m, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(1.3, 0, startY, 0)
    })
    tween:Play()
    tween.Completed:Connect(function() m:Destroy() end)
end

task.spawn(function()
    while splash.Parent do
        createMeteor()
        task.wait(math.random(30, 60) / 100)
