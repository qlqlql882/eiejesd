-- ==================== 飞行（斜跳反检测） ====================
local flyBV,flyLoop
local function startFly()
local char=LP.Character
if not char then return end
local hrp=char:FindFirstChild("HumanoidRootPart")
if not hrp then return end
flyBV=Instance.new("BodyVelocity")
flyBV.Name="PrayFlyBV"
flyBV.MaxForce=Vector3.new(1e5,1e5,1e5)
flyBV.Velocity=Vector3.new(0,0,0)
flyBV.Parent=hrp
flyLoop=RunService.RenderStepped:Connect(function()
if not State.flyOn or not flyBV then return end
local c=LP.Character
if not c then return end
local hum=c:FindFirstChildOfClass("Humanoid")
if not hum then return end
local hrp2=c:FindFirstChild("HumanoidRootPart")
if not hrp2 then return end
local moveDir=hum.MoveDirection
if flyUp then
flyBV.Velocity=Vector3.new(moveDir.X*25,20,moveDir.Z*25)
elseif flyDown then
flyBV.Velocity=Vector3.new(moveDir.X*25,-20,moveDir.Z*25)
elseif moveDir.Magnitude>0 then
flyBV.Velocity=moveDir*35+Vector3.new(0,12,0)
else
flyBV.Velocity=Vector3.new(0,-10,0)
end
local ray=Ray.new(hrp2.Position,Vector3.new(0,-200,0))
local hit,pos=workspace:FindPartOnRay(ray,c)
if hit and pos then
local height=hrp2.Position.Y-pos.Y
if height>25 and flyBV.Velocity.Y>0 then
flyBV.Velocity=Vector3.new(flyBV.Velocity.X,0,flyBV.Velocity.Z)
end
end
end)
end
local function stopFly()
if flyBV then flyBV:Destroy(); flyBV=nil end
if flyLoop then flyLoop:Disconnect(); flyLoop=nil end
flyUp=false
flyDown=false
end
-- ==================== 绕过反作弊 ====================
local function enableBypass()
if not hookmetamethod or not newcclosure then return end
pcall(function()
local mt=getrawmetatable(game)
local oldNamecall=mt.__namecall
setreadonly(mt,false)
mt.__namecall=newcclosure(function(self,...)
local method=getnamecallmethod()
if State.bypassOn then
if method=="Kick" and self==LP then return end
if method=="FireServer" and tostring(self)=="PlayerEvent" then
local a={...}
if a[1]=="combatMode" or a[1]=="takeDamage" then return end
end
end
return oldNamecall(self,...)
end)
setreadonly(mt,true)
end)
end
