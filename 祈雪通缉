local function isValidTarget(p,teamMode)
if p==LP then return false end
if not p.Character then return false end
local hum=p.Character:FindFirstChildOfClass("Humanoid")
if not hum or hum.Health<=0 then return false end
if teamMode=="队伍" and not isTeammate(p) then return false end
if teamMode=="敌人" and isTeammate(p) then return false end
return true
end
local aimbotLoop
local function getAimbotTarget()
local cam=workspace.CurrentCamera
local center=cam.ViewportSize/2
local best,bestDist=nil,math.huge
for _,p in ipairs(Players:GetPlayers()) do
if isValidTarget(p,State.aimbotTeam) then
local part
if State.aimbotPart=="头部" then
part=p.Character:FindFirstChild("Head")
else
part=p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")
end
if not part then part=p.Character:FindFirstChild("HumanoidRootPart") end
if part then
local screenPos,onScreen=cam:WorldToViewportPoint(part.Position)
if onScreen then
local dx=screenPos.X-center.X
local dy=screenPos.Y-center.Y
local dist=math.sqrt(dx*dx+dy*dy)
if dist<=State.aimbotFov and dist<bestDist then
best=part
bestDist=dist
end
end
end
end
end
return best
end
